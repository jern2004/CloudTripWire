# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit real secrets.

# Shared secret required on X-API-Key header for POST /api/incidents and
# PATCH /api/incident/{id}. Leave unset for local dev (auth disabled).
# MUST be set before exposing this API publicly via ngrok — set the SAME
# value as DASHBOARD_API_KEY on the Lambda / Logic App, and as VITE_API_KEY
# on the frontend.
INCIDENT_API_KEY=

# Optional overrides — defaults are fine for local dev.
# DATABASE_URL=sqlite:///./cloudtripwire.db
