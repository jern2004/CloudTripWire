# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit real secrets.
# Vite only exposes vars prefixed VITE_ to the browser.

# Backend API base URL. Defaults to http://127.0.0.1:8000/api if unset.
VITE_API_BASE_URL=

# Must match backend's INCIDENT_API_KEY if that's set. Leave unset otherwise.
VITE_API_KEY=
