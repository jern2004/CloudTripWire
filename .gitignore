# ── Credentials — NEVER commit these ──────────────────────────────────────────
honeytokens/honeytoken_keys.txt
azure/config.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Lambda build artifact ──────────────────────────────────────────────────────
response/aws_lambda/lambda_package.zip

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.env
.env.local
.env.*.local

# ── Terraform state (contains sensitive data) ─────────────────────────────────
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/tfplan*.out
# .terraform.lock.hcl is intentionally tracked — it pins provider versions, no secrets

